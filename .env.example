# DataForSEO REST API credentials -- https://app.dataforseo.com/api-access
#
# Copy this file to .env and fill in your values, or export them in your shell.
# NOTE: the password here is the DataForSEO *API* password, which is different
# from the password you use to log into app.dataforseo.com.
#
#   export DATAFORSEO_LOGIN="your-login"
#   export DATAFORSEO_PASSWORD="your-api-password"
#
# Or pass the Base64 form DataForSEO shows on the API Access page:
#   echo "BASE64_BLOB" | base64 -d    # -> login:password

DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
